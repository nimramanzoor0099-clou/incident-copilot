# The frontend calls the backend through the Vite dev proxy at /api (see vite.config.js).
# Backend location for the dev proxy (default http://localhost:4000):
BACKEND_URL=http://localhost:4000

# For a production build served from a different domain, set the full API base:
# VITE_API_BASE=https://your-backend.example.com/api
# Do not put JWT_SECRET or ANTHROPIC_API_KEY in frontend variables.

# Optional: send analysis to a different endpoint instead of the backend.
# VITE_API_URL=
