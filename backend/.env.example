PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- Claude (Anthropic)
# Get a key at https://console.anthropic.com  (Settings > API keys)
# Leave empty to use the built-in rule engine.
ANTHROPIC_API_KEY=
# Models: claude-sonnet-5-5 (balanced, default), claude-haiku-5-5 (fastest and cheapest), claude-opus-5-5 (most capable)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional tuning
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=8000

# ---------------------------------------------------------------- Security
# JWT authentication is required for all workspace APIs. Set a strong secret before deployment.

# Rate limit for POST /api/analyze (requests per minute per IP)
ANALYZE_RATE_LIMIT=30

# ---------------------------------------------------------------- Database
# SQLite database file (relative paths are resolved from the backend folder)
DB_PATH=database/incident-copilot.db

# true: an empty database is filled with the demo workspace (36 incidents, 7 members).
# false: an empty database starts clean with one owner account (set below).
SEED_DEMO_DATA=true
ORG_NAME=My Workspace
OWNER_NAME=Workspace Owner
OWNER_EMAIL=owner@example.com

# Authentication: use a long, random secret (at least 32 bytes) in production
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
JWT_TTL_SECONDS=86400
